[init]
	defaultBranch = main
[user]
	name = andrader
	email = 38709237+andrader@users.noreply.github.com

[core]
	editor = code --wait
	pager = less -FRX
[sequence]
	editor = code --wait --reuse-window

[alias]
	br = branch
	co = checkout
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = !gitk
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	clean = cleanup
	dm = "!f(){ set -e; git checkout main; before=$(git stash list | wc -l); git stash push -u -m \"auto-stash before pull\" >/dev/null 2>&1 || true; after=$(git stash list | wc -l); git pull --ff-only; git branch --merged main | egrep -v \"^\\*|main\" | xargs -r git branch -d; if [ \"$after\" -gt \"$before\" ]; then git stash pop --index || true; fi; }; f"
[credential]
	helper = store
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
